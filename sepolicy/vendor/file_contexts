# Files in rootfs
/bt_firmware(/.*)?       u:object_r:bt_firmware_file:s0
/firmware(/.*)?          u:object_r:firmware_file:s0
/persist(/.*)?           u:object_r:mnt_vendor_file:s0

# Sys files
/sys/devices(/platform)?/soc/[a-z0-9]+\.qcom,jpeg/video4linux/video[0-9]+/name(/.*)?    u:object_r:sysfs_graphics:s0
/sys/kernel/boot_wlan(/.*)?                                                             u:object_r:sysfs_wifi:s0

# DT2W
/sys/android_touch/doubletap2wake				  u:object_r:sysfs_doubletap_gesture:s0

# Fingerprint
/vendor/bin/hw/android\.hardware\.biometrics\.fingerprint\.fpc@2\.1-service   u:object_r:hal_fingerprint_fpc_exec:s0
/vendor/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.1-service   u:object_r:hal_fingerprint_fpc_exec:s0

# Power
/(vendor|system/vendor)/bin/hw/android\.hardware\.power\.stats@1\.0-service\.mock              u:object_r:hal_power_stats_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power@1\.3-service\.gm-libperfmgr             u:object_r:hal_power_default_exec:s0
