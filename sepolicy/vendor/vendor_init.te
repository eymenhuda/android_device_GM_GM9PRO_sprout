typeattribute vendor_init data_between_core_and_vendor_violators;

allow vendor_init {
  audio_data_file
  camera_data_file
  dhcp_data_file
  media_rw_data_file
  nfc_data_file
  system_data_file
  tombstone_data_file
  wifi_data_file
}:dir { create search getattr open read setattr ioctl write add_name remove_name rmdir relabelfrom };

allow vendor_init audio_data_file:file { getattr setattr relabelfrom };
allow vendor_init block_device:lnk_file setattr;
set_prop(vendor_init, vendor_power_prop)

# Properties supplied by /vendor/build.prop on this legacy device.
set_prop(vendor_init, camera_prop)

# init.zram.rc actions.
allow vendor_init proc_watermark_scale_factor:file w_file_perms;

# The legacy Wi-Fi HAL is power-cycled by init through /dev/wlan.
allow vendor_init wlan_device:chr_file w_file_perms;

allow vendor_init proc_dirty_ratio:file w_file_perms;
allow vendor_init proc_dirty:file w_file_perms;
