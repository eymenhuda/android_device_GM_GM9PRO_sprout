on early-init
    write /sys/block/zram0/comp_algorithm lz4

on post-fs-data
    # reset previous state
    write /sys/block/zram0/reset 1

    # compression
    write /sys/block/zram0/comp_algorithm lz4

    # 3 GB ZRAM
    write /sys/block/zram0/disksize 3221225472

    # enable swap
    exec -- /system/bin/mkswap /dev/block/zram0
    exec -- /system/bin/swapon /dev/block/zram0 -p 32758

    # aggressive VM tuning for responsiveness under RAM pressure
    write /proc/sys/vm/swappiness 180
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/dirty_ratio 18
    write /proc/sys/vm/dirty_background_ratio 6
    write /proc/sys/vm/vfs_cache_pressure 40
    write /proc/sys/vm/watermark_scale_factor 160
    write /proc/sys/vm/extfrag_threshold 750

    # storage queue tuning
    write /sys/block/mmcblk0/queue/read_ahead_kb 256
